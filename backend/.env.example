# Copy to .env (git-ignored) and adjust. Real environment variables override .env.
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
DB_SSLMODE=disable
DB_MAX_CONNS=10

# Integration tests (docker-compose postgres-test)
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USER=app
TEST_DB_PASSWORD=app
TEST_DB_NAME=app_test
